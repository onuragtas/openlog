# Environment of the compose auto-update acceptance test (project openlog-updtest).
# OPENLOG_IMAGE, OPENLOG_UPDATER_IMAGE, OPENLOG_RELEASE_INDEX_URL, OPENLOG_UPDATER_BACKUP_DIR and
# UPDTEST_WORK are set by the test.
OPENLOG_AUTH_MODE=postgres
OPENLOG_POSTGRES_PASSWORD=openlog
OPENLOG_BOOTSTRAP_TENANT_ID=updtest
OPENLOG_BOOTSTRAP_ORG_NAME=updtest
OPENLOG_BOOTSTRAP_OWNER_EMAIL=owner@updtest.test
OPENLOG_BOOTSTRAP_OWNER_PASSWORD=updtest-owner-password
OPENLOG_BOOTSTRAP_LICENSE_KEY=updtest-license-key
OPENLOG_BOOTSTRAP_API_KEY=ola_updtest-api-key
OPENLOG_COOKIE_SECURE=false
OPENLOG_CLICKHOUSE_USER=openlog
OPENLOG_CLICKHOUSE_PASSWORD=openlog
OPENLOG_KAFKA_PARTITIONS=3
OPENLOG_UPDATE_CHECK=disabled

OPENLOG_UPDATER_MODE=auto
OPENLOG_UPDATER_INTERVAL=10s
OPENLOG_UPDATER_HEALTH_TIMEOUT=90s
OPENLOG_UPDATER_BACKUP_KEEP=3

OPENLOG_OTLP_GRPC_PORT=25317
OPENLOG_OTLP_HTTP_PORT=25318
OPENLOG_API_PORT=25080
OPENLOG_ADMIN_PORT=25464
KAFKA_HOST_PORT=25092
CLICKHOUSE_HTTP_HOST_PORT=25123
CLICKHOUSE_NATIVE_HOST_PORT=25900
POSTGRES_HOST_PORT=25432
