# Environment for the e2e compose project (openlog-e2e). Host ports are shifted so the test
# does not collide with a developer's `make compose-up` stack.
OPENLOG_IMAGE=openlog:e2e
OPENLOG_LOG_LEVEL=info
# PostgreSQL tenancy. The base `bootstrap` service creates tenant e2e-tenant with the keys below;
# `bootstrap-other` (docker-compose.e2e.yml) creates e2e-other-tenant for the isolation test.
OPENLOG_AUTH_MODE=postgres
OPENLOG_POSTGRES_PASSWORD=openlog
OPENLOG_BOOTSTRAP_TENANT_ID=e2e-tenant
OPENLOG_BOOTSTRAP_ORG_NAME=e2e
OPENLOG_BOOTSTRAP_OWNER_EMAIL=owner@e2e.test
OPENLOG_BOOTSTRAP_OWNER_PASSWORD=e2e-owner-password
OPENLOG_BOOTSTRAP_LICENSE_KEY=e2e-license-key
OPENLOG_BOOTSTRAP_API_KEY=ola_e2e-api-key
OPENLOG_LOADGEN_KEY=e2e-license-key
OPENLOG_CLICKHOUSE_USER=openlog
OPENLOG_CLICKHOUSE_PASSWORD=openlog
OPENLOG_KAFKA_PARTITIONS=3
OPENLOG_KAFKA_MIN_INSYNC_REPLICAS=1
OPENLOG_KAFKA_RETENTION_MS=86400000
OPENLOG_KAFKA_MAX_MESSAGE_BYTES=12582912

# Ingest keys (agents) and read-only API keys (test queries) of the two organizations.
E2E_LICENSE_KEY=e2e-license-key
E2E_OTHER_LICENSE_KEY=e2e-other-key
E2E_API_KEY=ola_e2e-api-key
E2E_OTHER_API_KEY=ola_e2e-other-api-key
E2E_OTHER_TENANT_ID=e2e-other-tenant
E2E_OTHER_OWNER_EMAIL=other@e2e.test
E2E_AGENT_VERSION=0.1.0-e2e
E2E_INVENTORY_INTERVAL=2m
E2E_TARGET_MACHINE_ID=0e2e0000000000000000000000000001
E2E_PLAIN_MACHINE_ID=0e2e0000000000000000000000000002

# Alerts phase (alerts_test.go): channel secret encryption key (32 bytes, base64) and the webhook receiver.
OPENLOG_SECRETS_KEY=ZTJlLW9wZW5sb2ctYWxlcnQtc2VjcmV0cy1rZXktMzI=
E2E_ALERT_HMAC_SECRET=e2e-alert-hmac-secret
E2E_ALERT_RECEIVER_PORT=18881

OPENLOG_OTLP_GRPC_PORT=14317
OPENLOG_OTLP_HTTP_PORT=14318
OPENLOG_API_PORT=18080
OPENLOG_ADMIN_PORT=19464
KAFKA_HOST_PORT=19092
CLICKHOUSE_HTTP_HOST_PORT=18123
CLICKHOUSE_NATIVE_HOST_PORT=19000
POSTGRES_HOST_PORT=15432
