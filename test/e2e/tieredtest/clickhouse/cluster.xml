<?xml version="1.0"?>
<!--
  ClickHouse node of the tiered storage test (test/e2e/tieredtest): cluster `openlog` with 2 shards x 2 replicas
  (ch-s1r1, ch-s1r2, ch-s2r1, ch-s2r2), Keeper embedded in ch-s1r1 (keeper.xml). The storage policy comes from
  deploy/compose/clickhouse/storage-tiered.xml + storage-tiered-warm.xml, unchanged.
-->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <macros>
        <cluster>openlog</cluster>
        <shard from_env="CH_SHARD"/>
        <replica from_env="CH_REPLICA"/>
    </macros>

    <remote_servers replace="true">
        <openlog>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>ch-s1r1</host><port>9000</port><user from_env="CLICKHOUSE_USER"/><password from_env="CLICKHOUSE_PASSWORD"/></replica>
                <replica><host>ch-s1r2</host><port>9000</port><user from_env="CLICKHOUSE_USER"/><password from_env="CLICKHOUSE_PASSWORD"/></replica>
            </shard>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>ch-s2r1</host><port>9000</port><user from_env="CLICKHOUSE_USER"/><password from_env="CLICKHOUSE_PASSWORD"/></replica>
                <replica><host>ch-s2r2</host><port>9000</port><user from_env="CLICKHOUSE_USER"/><password from_env="CLICKHOUSE_PASSWORD"/></replica>
            </shard>
        </openlog>
    </remote_servers>

    <interserver_http_host from_env="CH_REPLICA"/>

    <zookeeper>
        <node>
            <host>ch-s1r1</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
</clickhouse>
