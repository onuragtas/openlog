<?xml version="1.0"?>
<!-- ch-s2r1: S3 credentials from a file (storage-tiered-credentials.xml.example); its environment has wrong keys. -->
<clickhouse>
    <storage_configuration>
        <disks>
            <openlog_s3>
                <access_key_id replace="replace">openlog-tiered</access_key_id>
                <secret_access_key replace="replace">openlog-tiered-secret</secret_access_key>
            </openlog_s3>
        </disks>
    </storage_configuration>
</clickhouse>
