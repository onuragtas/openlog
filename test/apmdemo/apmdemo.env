# Environment of the APM demo compose project (openlog-apmdemo): the openlog `single` stack plus the
# demo services of docker-compose.apmdemo.yml. Host ports are shifted (31xxx, below the Linux ephemeral range 32768-60999) so the demo runs next
# to a developer's `openlog` stack and the test suites.
OPENLOG_IMAGE=openlog:apm
OPENLOG_LOG_LEVEL=info
OPENLOG_AUTH_MODE=postgres
OPENLOG_POSTGRES_PASSWORD=openlog
OPENLOG_CLICKHOUSE_USER=openlog
OPENLOG_CLICKHOUSE_PASSWORD=openlog
OPENLOG_BOOTSTRAP_TENANT_ID=apmdemo
OPENLOG_BOOTSTRAP_ORG_NAME=APM demo
OPENLOG_BOOTSTRAP_OWNER_EMAIL=admin@apmdemo.local
OPENLOG_BOOTSTRAP_OWNER_PASSWORD=apmdemo-password
OPENLOG_BOOTSTRAP_LICENSE_KEY=apmdemo-license-key
OPENLOG_BOOTSTRAP_API_KEY=ola_apmdemo-api-key
OPENLOG_UPDATE_CHECK=disabled
OPENLOG_KAFKA_PARTITIONS=3

OPENLOG_OTLP_GRPC_PORT=31317
OPENLOG_OTLP_HTTP_PORT=31318
OPENLOG_API_PORT=31080
OPENLOG_ADMIN_PORT=31464
KAFKA_HOST_PORT=31092
CLICKHOUSE_HTTP_HOST_PORT=31123
CLICKHOUSE_NATIVE_HOST_PORT=31900
POSTGRES_HOST_PORT=31432

APMDEMO_LICENSE_KEY=apmdemo-license-key
APMDEMO_FRONTEND_PORT=31000
APMDEMO_LOADGEN_RPS=8

# host.id of the demo services = machine-id of the apmdemo-host agent container
APMDEMO_HOST_ID=a0de0000000000000000000000000001
