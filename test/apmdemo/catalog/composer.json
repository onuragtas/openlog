{
    "name": "openlog-apmdemo/catalog",
    "description": "openlog APM demo: PHP catalog service (Slim 4 + OpenTelemetry auto-instrumentation)",
    "type": "project",
    "license": "AGPL-3.0-only",
    "require": {
        "php": "^8.3",
        "ext-opentelemetry": "*",
        "ext-redis": "*",
        "open-telemetry/exporter-otlp": "1.4.0",
        "open-telemetry/opentelemetry-auto-slim": "1.5.0",
        "open-telemetry/sdk": "1.15.0",
        "php-http/guzzle7-adapter": "1.1.0",
        "slim/psr7": "1.8.0",
        "slim/slim": "4.15.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "tbachert/spi": true
        }
    }
}
