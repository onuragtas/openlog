.DS_Store
/bin/
# Release output, including throwaway test keys (dist/testkeys/).
/dist/
/agents/infra/dist/
# Local compose state: your .env, release mirror and updater backups.
/deploy/compose/.env
/deploy/compose/.env.bak
/deploy/compose/releases/
/deploy/compose/backups/
# Locally built binaries.
/agents/infra/openlog-infra-agent
/agents/infra/openlog-infra-agent-*
# Throwaway TLS material generated by test runs.
/test/alertproof/.certs/
# Test and browser automation output.
test-results/
playwright-report/
# Browser SDK build output (both are what `make -C agents/browser clean` removes).
/agents/browser/dist/
/agents/browser/.test-build/
# PHP extension build output.
/agents/php/ext/**/*.o
/agents/php/ext/**/*.lo
/agents/php/ext/**/*.la
/agents/php/ext/**/.libs/
/agents/php/ext/**/modules/

# Release signing keys must never be committed (docs/operations/releasing.md).
openlog-release-key-*.env
*.release-key.env

# Installed dependencies and compiled test output of the JavaScript packages (web, agents/*).
node_modules/
.test-build/
