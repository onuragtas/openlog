# Copy to .env and adjust. All values are optional; defaults are shown.

# Tenancy and users live in PostgreSQL (OPENLOG_AUTH_MODE=postgres). The one-shot `bootstrap`
# service creates this organization, owner and ingest key on first start (idempotent).
# Sign in to the UI at http://localhost:8080 with the owner email and password.
OPENLOG_AUTH_MODE=postgres
OPENLOG_POSTGRES_PASSWORD=openlog
OPENLOG_BOOTSTRAP_TENANT_ID=default
OPENLOG_BOOTSTRAP_ORG_NAME=Default
OPENLOG_BOOTSTRAP_OWNER_EMAIL=admin@openlog.local
OPENLOG_BOOTSTRAP_OWNER_PASSWORD=openlog-dev-password
OPENLOG_BOOTSTRAP_LICENSE_KEY=dev-license-key
# Optional read-only API key for scripts (Authorization: Bearer ...)
OPENLOG_BOOTSTRAP_API_KEY=
# Plain HTTP: the session cookie cannot be Secure. Set true behind TLS.
OPENLOG_COOKIE_SECURE=false
OPENLOG_SIGNUP_ENABLED=false
# Revoked ingest keys are accepted for up to this long.
OPENLOG_AUTH_CACHE_TTL=60s
OPENLOG_LOADGEN_KEY=dev-license-key

# OPENLOG_AUTH_MODE=static only (development/tests, no UI sign-in): key1=tenant1,key2=tenant2
OPENLOG_LICENSE_KEYS=dev-license-key=default

OPENLOG_LOG_LEVEL=info
OPENLOG_IMAGE=openlog:dev

# Browser OTLP senders (frontend logs/traces via fetch) need CORS on ingest :4318, e.g.
# https://app.example.com,https://*.example.com or * (empty = disabled).
OPENLOG_INGEST_CORS_ALLOWED_ORIGINS=
# Real user monitoring (docs/contracts/rum.md, D-136): POST /v1/rum for the browser SDK and the RUM screens.
# The browser key carries its own origin allowlist, so this needs no CORS setting above.
OPENLOG_RUM_ENABLED=
# Tail-based sampling (docs/operations/tail-sampling.md). Off = no behavior change.
OPENLOG_TAILSAMPLING_ENABLED=false
OPENLOG_TAILSAMPLING_DECISION_WAIT=30s
# JSON policy for organizations without a saved one, e.g. {"enabled":true,"baseline_ratio":0.1,"max_spans_per_second":0,"rules":[{"name":"errors","type":"error"}]}
OPENLOG_TAILSAMPLING_DEFAULT_POLICY=

# Encrypts alert notification channel secrets (webhook URLs, SMTP passwords). DEVELOPMENT VALUE ONLY:
# generate your own with `openssl rand -base64 32` for any real installation and keep it with backups.
OPENLOG_SECRETS_KEY=DjUnsPWWeAosbQQvH524ZIJe9QRe8H/Kocsw9MmiiYY=

# ClickHouse credentials (created by the clickhouse-server image on first start)
OPENLOG_CLICKHOUSE_USER=openlog
OPENLOG_CLICKHOUSE_PASSWORD=openlog
# Read-only user `openlog_reader` of api/alert queries (clickhouse/openlog-reader.xml). Change it too.
OPENLOG_CLICKHOUSE_READ_PASSWORD=openlog-read
# Per-tenant query limits (0 = ClickHouse profile default); overrides: tenant:max_memory_usage=N;max_rows_to_read=N,...
OPENLOG_QUERY_MAX_MEMORY_USAGE=2147483648
OPENLOG_QUERY_MAX_ROWS_TO_READ=2000000000

# Kafka topics (applied only when openlog-migrate creates them; existing topics are untouched).
# Replication factor is fixed at 1 in this single-broker profile, so min.insync.replicas must stay 1.
OPENLOG_KAFKA_PARTITIONS=6
OPENLOG_KAFKA_MIN_INSYNC_REPLICAS=1
OPENLOG_KAFKA_RETENTION_MS=86400000
OPENLOG_KAFKA_MAX_MESSAGE_BYTES=12582912

# Host ports
OPENLOG_OTLP_GRPC_PORT=4317
OPENLOG_OTLP_HTTP_PORT=4318
OPENLOG_API_PORT=8080
OPENLOG_ADMIN_PORT=9464
KAFKA_HOST_PORT=9092
CLICKHOUSE_HTTP_HOST_PORT=8123
CLICKHOUSE_NATIVE_HOST_PORT=9000
POSTGRES_HOST_PORT=5432

# Release check shown in the UI (openlog checks the signed release index every interval).
OPENLOG_UPDATE_CHECK=enabled
OPENLOG_UPDATE_CHECK_INTERVAL=24h
OPENLOG_UPDATE_CHANNEL=stable
OPENLOG_RELEASE_INDEX_URL=https://github.com/onuragtas/openlog/releases/latest/download/index.json
# Extra trusted release public keys (release images have the official keys compiled in), e.g.
# /releases/trusted-keys.txt. ./releases (OPENLOG_RELEASE_HOST_DIR) is mounted read-only at /releases.
OPENLOG_RELEASE_TRUSTED_KEYS_FILE=
OPENLOG_RELEASE_HOST_DIR=./releases

# Agent fleet updates. Air-gapped: copy releases to ./releases and set OPENLOG_RELEASE_MIRROR_DIR=/releases;
# OPENLOG_RELEASE_SERVE_MIRROR=true lets agents download from ingest instead of the release URL.
OPENLOG_RELEASE_MIRROR_DIR=
OPENLOG_RELEASE_SERVE_MIRROR=false
OPENLOG_RELEASE_CATALOG_REFRESH=15m
OPENLOG_FLEET_SYNC_INTERVAL=300s
OPENLOG_FLEET_CONTROLLER_INTERVAL=30s

# Automatic updates: docker compose --profile updater up -d openlog-updater (docs/operations/upgrading.md)
# off | notify (report only) | auto (backup, migrate, recreate, health check, rollback)
OPENLOG_UPDATER_MODE=notify
OPENLOG_UPDATER_INTERVAL=1h
# UTC windows for auto updates, e.g. "sat,sun 02:00-05:00; mon-fri 03:00-04:00" (empty = any time)
OPENLOG_UPDATER_MAINTENANCE_WINDOW=
OPENLOG_UPDATER_BACKUP_DIR=./backups
OPENLOG_UPDATER_BACKUP_KEEP=5
# install-server.sh installations: auto replaces the compose files by the verified bundle of each installed version
# (previous files in .bundle-previous/); off never changes them
#OPENLOG_UPDATER_COMPOSE_SYNC=auto
# After an update the updater replaces its own container with the installed image: auto (install-server.sh
# installations), on (every Compose installation), off (only report an outdated updater)
#OPENLOG_UPDATER_SELF_UPDATE=auto

# Tiered storage: old parts move from the local disk to S3 (docs/operations/tiered-storage.md). Enable all three
# lines; COMPOSE_PROFILES=tiered starts a local MinIO for testing (keep the S3 defaults below for it).
#COMPOSE_PROFILES=tiered
#OPENLOG_CLICKHOUSE_STORAGE_CONFIG=./clickhouse/storage-tiered.xml
#OPENLOG_STORAGE_TIERING_ENABLED=true
# Bucket URL with a per-node prefix, e.g. https://my-bucket.s3.eu-central-1.amazonaws.com/openlog/ch-1/
#OPENLOG_S3_ENDPOINT=http://minio:9000/openlog-cold/ch-1/
#OPENLOG_S3_REGION=
# Static keys, or leave both empty and set OPENLOG_S3_USE_ENVIRONMENT_CREDENTIALS=true (IAM instance profile).
# Keys from a file instead: OPENLOG_CLICKHOUSE_S3_CREDENTIALS_FILE (clickhouse/storage-tiered-credentials.xml.example).
#OPENLOG_S3_ACCESS_KEY_ID=openlog-minio
#OPENLOG_S3_SECRET_ACCESS_KEY=openlog-minio-secret
#OPENLOG_S3_USE_ENVIRONMENT_CREDENTIALS=false
# Local read cache of cold data (on the ClickHouse data volume).
#OPENLOG_S3_CACHE_MAX_SIZE=10Gi
# Days after which data moves to S3 (0 = never; must be below the retention: metrics 30, metrics_1m 395, logs 14,
# traces 7, APM OPENLOG_APM_RETENTION_DAYS, alerts 30, RUM 30).
#OPENLOG_STORAGE_COLD_AFTER_DAYS_METRICS=7
#OPENLOG_STORAGE_COLD_AFTER_DAYS_METRICS_1M=30
#OPENLOG_STORAGE_COLD_AFTER_DAYS_LOGS=3
#OPENLOG_STORAGE_COLD_AFTER_DAYS_TRACES=3
#OPENLOG_STORAGE_COLD_AFTER_DAYS_APM=7
#OPENLOG_STORAGE_COLD_AFTER_DAYS_ALERTS=7
#OPENLOG_STORAGE_COLD_AFTER_DAYS_RUM=7
# Optional warm volume (a second local disk, the clickhouse-warm Docker volume) before S3:
#OPENLOG_CLICKHOUSE_STORAGE_WARM_CONFIG=./clickhouse/storage-tiered-warm.xml
#OPENLOG_STORAGE_WARM_AFTER_DAYS_LOGS=1
#OPENLOG_STORAGE_WARM_AFTER_DAYS_METRICS=0
#OPENLOG_STORAGE_WARM_AFTER_DAYS_METRICS_1M=0
#OPENLOG_STORAGE_WARM_AFTER_DAYS_TRACES=0
#OPENLOG_STORAGE_WARM_AFTER_DAYS_RUM=0
#OPENLOG_STORAGE_WARM_AFTER_DAYS_APM=0
#OPENLOG_STORAGE_WARM_AFTER_DAYS_ALERTS=0
#OPENLOG_STORAGE_POLICY=openlog_tiered

# =============================================================================
# Everything below is optional: uncomment to change a default. Descriptions: docs/contracts/config.md.
# =============================================================================

# ---- E-mail (invitations, verification, alert channels, usage notices) and links ----
#OPENLOG_PUBLIC_URL=http://localhost:8080
# Public ingest addresses in the UI's "Add data" install commands; empty = host of OPENLOG_PUBLIC_URL with :4318 / :4317
#OPENLOG_INGEST_PUBLIC_URL=
#OPENLOG_INGEST_PUBLIC_GRPC_URL=
#OPENLOG_SMTP_HOST=
#OPENLOG_SMTP_PORT=587
#OPENLOG_SMTP_USERNAME=
#OPENLOG_SMTP_PASSWORD=
#OPENLOG_SMTP_FROM=openlog <alerts@example.com>
# starttls | tls | none
#OPENLOG_SMTP_TLS=starttls
#OPENLOG_SMTP_INSECURE_SKIP_VERIFY=false

# ---- Secrets (generate your own; keep them with your backups) ----
# Old channel secret keys during a rotation (comma-separated), then run `openlog-alert rotate-secrets`.
#OPENLOG_SECRETS_KEY_PREVIOUS=
# HMAC secret for stored license/API keys, >= 32 bytes: openssl rand -base64 48 (also used by `bootstrap`).
#OPENLOG_KEY_HASH_SECRET=
#OPENLOG_KEY_HASH_SECRET_PREVIOUS=
# Encrypts OIDC client secrets and SAML keys, >= 32 bytes (empty = derived from OPENLOG_KEY_HASH_SECRET).
#OPENLOG_SSO_SECRET_KEY=
#OPENLOG_SSO_SECRET_KEY_PREVIOUS=

# ---- API, sessions and sign-up ----
#OPENLOG_API_QUERY_TIMEOUT=30s
#OPENLOG_API_MAX_ROWS=10000
#OPENLOG_API_UI_ENABLED=true
# Reverse proxies whose X-Forwarded-For is trusted, e.g. 172.16.0.0/12
#OPENLOG_API_TRUSTED_PROXIES=
#OPENLOG_SESSION_TTL=168h
#OPENLOG_SESSION_IDLE_TIMEOUT=24h
#OPENLOG_COOKIE_DOMAIN=
#OPENLOG_LOGIN_MAX_FAILURES=10
#OPENLOG_LOGIN_WINDOW=15m
#OPENLOG_INVITATION_TTL=168h
#OPENLOG_AUTH_NEGATIVE_CACHE_TTL=10s
#OPENLOG_AUTH_CACHE_MAX_STALE=15m
# Empty = automatic (true when SMTP and OPENLOG_PUBLIC_URL are set)
#OPENLOG_SIGNUP_REQUIRE_VERIFICATION=
#OPENLOG_EMAIL_VERIFICATION_TTL=48h
#OPENLOG_SIGNUP_MAX_PER_IP=10
#OPENLOG_SIGNUP_MAX_PER_EMAIL=5
#OPENLOG_SIGNUP_RATE_WINDOW=1h
#OPENLOG_SIGNUP_BLOCKED_EMAIL_DOMAINS=
#OPENLOG_SIGNUP_BLOCKED_EMAIL_DOMAINS_FILE=
# turnstile | hcaptcha (then secret and site key are required)
#OPENLOG_SIGNUP_CAPTCHA_PROVIDER=
#OPENLOG_SIGNUP_CAPTCHA_SECRET=
#OPENLOG_SIGNUP_CAPTCHA_SITE_KEY=
#OPENLOG_BOOTSTRAP_OWNER_NAME=

# ---- Single sign-on and SCIM ----
#OPENLOG_SSO_ENABLED=true
# Empty = automatic (true unless OPENLOG_SIGNUP_ENABLED=true)
#OPENLOG_SSO_ALLOW_PRIVATE_NETWORKS=
#OPENLOG_SSO_LOGIN_TTL=10m
#OPENLOG_SSO_CLOCK_SKEW=2m
#OPENLOG_SSO_HTTP_TIMEOUT=10s
#OPENLOG_SCIM_ENABLED=true

# ---- Ingest and processor ----
#OPENLOG_INGEST_MAX_BODY_BYTES=10485760
#OPENLOG_INGEST_PRODUCE_TIMEOUT=10s
#OPENLOG_KAFKA_TOPIC_PREFIX=openlog
#OPENLOG_POSTGRES_MAX_CONNS=10
#OPENLOG_PROCESSOR_GROUP=openlog-processor
#OPENLOG_PROCESSOR_BATCH_ROWS=50000
#OPENLOG_PROCESSOR_BATCH_BYTES=8388608
#OPENLOG_PROCESSOR_FLUSH_INTERVAL=2s
#OPENLOG_PROCESSOR_INSERT_TIMEOUT=30s
#OPENLOG_PROCESSOR_MAX_BUFFERED_BYTES=134217728
#OPENLOG_PROCESSOR_INSERT_CONCURRENCY=4
# direct | distributed
#OPENLOG_PROCESSOR_INSERT_MODE=direct
#OPENLOG_PROCESSOR_TOPOLOGY_REFRESH=1m
#OPENLOG_PROCESSOR_INSERT_QUORUM=0

# ---- Query limits (organization settings in the UI override the defaults; docs/contracts/usage.md §4.5) ----
#OPENLOG_QUERY_MAX_BYTES_TO_READ=0
#OPENLOG_QUERY_TENANT_LIMITS=

# ---- APM ----
#OPENLOG_APM_DEFAULT_APDEX_T=500ms
#OPENLOG_APM_LINK_ENABLED=true
#OPENLOG_APM_LINK_INTERVAL=1m
#OPENLOG_APM_LINK_LOOKBACK=10m
#OPENLOG_APM_LINK_DELAY=1m
#OPENLOG_APM_LINK_CATCHUP_ENABLED=true
#OPENLOG_APM_LINK_CATCHUP_AT=03:00
#OPENLOG_APM_LINK_CATCHUP_BATCH=1h
#OPENLOG_APM_RELINK_ENABLED=true
#OPENLOG_APM_RELINK_AFTER=10m
#OPENLOG_APM_RELINK_MAX_AGE=168h
#OPENLOG_APM_RELINK_INTERVAL=5m
#OPENLOG_APM_RELINK_MAX_MINUTES=120
#OPENLOG_APM_RETENTION_DAYS=30

# ---- Alerting ----
#OPENLOG_ALERT_ENABLED=true
#OPENLOG_ALERT_EVALUATION_DELAY=15s
# true for SaaS: no webhook/SMTP destinations on private addresses
#OPENLOG_ALERT_BLOCK_PRIVATE_DESTINATIONS=false
#OPENLOG_ALERT_LEASE_TTL=30s
#OPENLOG_ALERT_LEASE_RENEW_INTERVAL=10s
#OPENLOG_ALERT_MAX_CONCURRENT_EVALUATIONS=16
#OPENLOG_ALERT_TENANT_MAX_CONCURRENT=4
#OPENLOG_ALERT_TENANT_EVALUATIONS_PER_MINUTE=600
#OPENLOG_ALERT_MAX_SERIES_PER_RULE=1000
#OPENLOG_ALERT_QUERY_TIMEOUT=20s
#OPENLOG_ALERT_MAX_RULES_PER_ORG=1000
#OPENLOG_ALERT_EVALUATION_HISTORY=true
#OPENLOG_ALERT_DISPATCH_WORKERS=4
#OPENLOG_ALERT_DELIVERY_TIMEOUT=10s
#OPENLOG_ALERT_DELIVERY_MAX_ATTEMPTS=10

# ---- Agent fleet ----
#OPENLOG_RELEASE_MIRROR_BASE_URL=
#OPENLOG_FLEET_ROLLOUT_SYNC_INTERVAL=60s
#OPENLOG_FLEET_POLICY_CACHE_TTL=15s
#OPENLOG_FLEET_HOST_STALE_AFTER=24h
#OPENLOG_FLEET_REPORT_QUEUE_SIZE=10000

# ---- Tail sampling ----
#OPENLOG_TAILSAMPLING_GROUP=openlog-sampler
#OPENLOG_TAILSAMPLING_MAX_BUFFERED_BYTES=268435456
#OPENLOG_TAILSAMPLING_MAX_TRACES=100000
#OPENLOG_TAILSAMPLING_MAX_SPANS_PER_TRACE=2000
#OPENLOG_TAILSAMPLING_DECISION_CACHE_TTL=10m
#OPENLOG_TAILSAMPLING_DECISION_CACHE_SIZE=500000
#OPENLOG_TAILSAMPLING_POLICY_REFRESH=30s
#OPENLOG_TAILSAMPLING_PRODUCE_TIMEOUT=10s

# ---- Usage, plans, quotas and billing (docs/operations/saas.md) ----
#OPENLOG_SAAS_MODE=false
# Plan catalog JSON (docs/contracts/usage.md §4.1), or a file under /releases
#OPENLOG_PLANS=
#OPENLOG_PLANS_FILE=
#OPENLOG_DEFAULT_PLAN=
#OPENLOG_SUPERADMIN_EMAILS=
#OPENLOG_USAGE_EVALUATION_INTERVAL=1m
#OPENLOG_USAGE_QUERY_COLLECTION_ENABLED=true
#OPENLOG_USAGE_NOTIFY_THRESHOLDS=80,100
#OPENLOG_QUOTA_REFRESH_INTERVAL=30s
#OPENLOG_QUOTA_INGEST_PODS=0
#OPENLOG_QUOTA_BLOCKED_RETRY_AFTER=5m
# Empty = OPENLOG_SAAS_MODE
#OPENLOG_QUOTA_RETENTION_ENABLED=
#OPENLOG_QUOTA_RETENTION_MAX_MUTATIONS=20
# none | noop
#OPENLOG_BILLING_PROVIDER=none
#OPENLOG_BILLING_PUSH_AT=02:00
# SaaS operations (docs/operations/saas.md §8-§11): enforcement and jobs only with OPENLOG_SAAS_MODE=true
#OPENLOG_SAAS_HOST_SYNC_INTERVAL=1m
# Plan with trial_days whose trial new sign-ups get (empty = none)
#OPENLOG_SAAS_SIGNUP_TRIAL_PLAN=
#OPENLOG_SAAS_TRIAL_NOTIFY_DAYS=7,3,1
#OPENLOG_SAAS_LIFECYCLE_INTERVAL=5m
#OPENLOG_SAAS_SUPPORT_SESSION_TTL=2h
#OPENLOG_SAAS_AUTO_SUSPEND=false
#OPENLOG_SAAS_ABUSE_INTERVAL=10m
#OPENLOG_SAAS_ABUSE_INGEST_MULTIPLIER=10
#OPENLOG_SAAS_ABUSE_NEW_ORG_DAYS=7
#OPENLOG_SAAS_ABUSE_NEW_ORG_HOSTS=50
#OPENLOG_SAAS_ABUSE_SOURCE_IPS=200

# ---- Data subject requests: exports and deletion (docs/operations/saas.md §12, D-107) ----
# Grace period in which an owner can cancel an organization deletion (0-2160h)
#OPENLOG_ORG_DELETION_GRACE=168h
#OPENLOG_DATA_EXPORT_ENABLED=true
# auto (s3 when an S3 URL is known, else local) | local | s3
#OPENLOG_DATA_EXPORT_STORAGE=auto
# Archives (local storage) and temporary files; the default is the volume `data-exports` of `openlog`
#OPENLOG_DATA_EXPORT_LOCAL_PATH=/var/lib/openlog/exports
# Bucket URL with prefix, ending with /. Empty + OPENLOG_STORAGE_TIERING_ENABLED=true: the OPENLOG_S3_* bucket above
#OPENLOG_DATA_EXPORT_S3_URL=
#OPENLOG_DATA_EXPORT_S3_REGION=
#OPENLOG_DATA_EXPORT_S3_ACCESS_KEY_ID=
#OPENLOG_DATA_EXPORT_S3_SECRET_ACCESS_KEY=
# static (the keys above) | auto (AWS credential chain: AWS_* env, web identity, ECS, EC2 instance profile; D-116).
# Empty: static when keys are set, else auto
#OPENLOG_DATA_EXPORT_S3_CREDENTIALS=
#OPENLOG_DATA_EXPORT_TTL=168h
#OPENLOG_DATA_EXPORT_MAX_BYTES=4294967296
#OPENLOG_DATA_EXPORT_MAX_ROWS=50000000
#OPENLOG_DATA_EXPORT_MAX_RANGE=744h
#OPENLOG_DATA_EXPORT_ROWS_PER_SECOND=200000
# ---- Public status page (/status, GET /api/v1/status; saas.md §13, D-108). Empty = OPENLOG_SAAS_MODE ----
#OPENLOG_STATUS_PAGE_ENABLED=

# ---- Synthetic monitoring: scheduled HTTP checks (api.md "Synthetic monitoring", D-132) ----
# The api leader runs the due checks, so the limits bound one process.
#OPENLOG_SYNTHETICS_ENABLED=true
# Let checks reach private/loopback addresses. Empty = true unless OPENLOG_SIGNUP_ENABLED=true (SSRF protection)
#OPENLOG_SYNTHETICS_ALLOW_PRIVATE_NETWORKS=
#OPENLOG_SYNTHETICS_MAX_CONCURRENT=20
#OPENLOG_SYNTHETICS_TENANT_MAX_CONCURRENT=5
#OPENLOG_SYNTHETICS_MAX_RESPONSE_BYTES=1048576
#OPENLOG_SYNTHETICS_MAX_REDIRECTS=5

# ---- Cloud connections: metrics of managed services (api.md "Cloud connections", D-135) ----
# Per organization, credentials are stored encrypted with OPENLOG_SECRETS_KEY (required to save them).
# The api leader polls the due connections, so the limits bound one process. These provider APIs are
# billed per request: the per-connection caps in the UI bound what one poll may spend.
#OPENLOG_CLOUD_ENABLED=true
#OPENLOG_CLOUD_MAX_CONCURRENT=10
#OPENLOG_CLOUD_TENANT_MAX_CONCURRENT=4
#OPENLOG_CLOUD_CONNECTION_MAX_CONCURRENT=2
#OPENLOG_CLOUD_REQUEST_TIMEOUT=30s

# ---- Infrastructure cost estimates (cost.md, D-134) ----
# Per-host, per-service and per-container cost from a static price table in the repository.
# Estimates, not billing data: no committed-use discounts, credits, taxes, storage or egress.
#OPENLOG_COST_ENABLED=true
# JSON file merged over the built-in price table, to correct a price without a release.
# Mount it into the container, e.g. ./prices.json:/etc/openlog/prices.json:ro
#OPENLOG_COST_PRICES_FILE=

# ---- PNG widget images in scheduled report e-mails (docs/operations/reports.md, D-097) ----
# docker compose --profile renderer up -d --build openlog-renderer, then set the URL and token below. Render tokens
# are signed with OPENLOG_KEY_HASH_SECRET (or OPENLOG_SECRETS_KEY): one of them must be set.
#OPENLOG_RENDERER_URL=http://openlog-renderer:8090
# Shared secret between openlog and openlog-renderer, >= 32 characters: openssl rand -hex 32
#OPENLOG_RENDERER_TOKEN=
#OPENLOG_RENDERER_TIMEOUT=2m
#OPENLOG_RENDERER_IMAGE=openlog-renderer:dev
#OPENLOG_RENDERER_MAX_CONCURRENCY=2
#OPENLOG_RENDERER_RENDER_TIMEOUT=60s
#OPENLOG_RENDERER_QUEUE_TIMEOUT=30s
#OPENLOG_RENDERER_MAX_IMAGE_BYTES=1048576
#OPENLOG_RENDERER_CHROMIUM_PATH=
# The Compose service is locked down (read-only, no capabilities, internal network); see reports.md before changing.
#OPENLOG_RENDERER_CHROMIUM_NO_SANDBOX=true
# Optional mTLS (files mounted into both containers)
#OPENLOG_RENDERER_TLS_CERT_FILE=
#OPENLOG_RENDERER_TLS_KEY_FILE=
#OPENLOG_RENDERER_TLS_CA_FILE=
