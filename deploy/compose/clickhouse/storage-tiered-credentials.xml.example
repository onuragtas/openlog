<?xml version="1.0"?>
<!--
  S3 credentials from a file instead of the environment (storage-tiered.xml). Copy it outside the repository,
  fill in the keys, make it readable by ClickHouse only and mount it as a config.d file that sorts AFTER the
  storage-tiered.xml mount (config.d files merge in name order; Compose mounts them as openlog-storage.xml and
  zz-openlog-s3-credentials.xml):

    OPENLOG_CLICKHOUSE_S3_CREDENTIALS_FILE=/etc/openlog/clickhouse-s3-credentials.xml

  replace="replace" drops the from_env elements of storage-tiered.xml, so OPENLOG_S3_ACCESS_KEY_ID and
  OPENLOG_S3_SECRET_ACCESS_KEY are ignored. ClickHouse writes the merged configuration (with the keys) to
  /var/lib/clickhouse/preprocessed_configs/config.xml, readable only by the clickhouse user.
-->
<clickhouse>
    <storage_configuration>
        <disks>
            <openlog_s3>
                <access_key_id replace="replace">AKIA...</access_key_id>
                <secret_access_key replace="replace">...</secret_access_key>
            </openlog_s3>
        </disks>
    </storage_configuration>
</clickhouse>
