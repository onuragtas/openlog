<?xml version="1.0"?>
<!--
  Single-node ClickHouse for the openlog `single` profile. Even with one node the
  schema uses ON CLUSTER DDL and Replicated engines, so we define:
    * cluster `openlog` with 1 shard x 1 replica (internal_replication = true)
    * embedded ClickHouse Keeper (single raft member) used as ZooKeeper
    * macros cluster/shard/replica used by the schema
-->
<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>

    <macros>
        <cluster>openlog</cluster>
        <shard>01</shard>
        <replica>ch-1</replica>
    </macros>

    <remote_servers replace="true">
        <openlog>
            <shard>
                <internal_replication>true</internal_replication>
                <replica>
                    <host>clickhouse</host>
                    <port>9000</port>
                    <user from_env="CLICKHOUSE_USER"/>
                    <password from_env="CLICKHOUSE_PASSWORD"/>
                </replica>
            </shard>
        </openlog>
    </remote_servers>

    <keeper_server>
        <tcp_port>9181</tcp_port>
        <server_id>1</server_id>
        <log_storage_path>/var/lib/clickhouse/coordination/log</log_storage_path>
        <snapshot_storage_path>/var/lib/clickhouse/coordination/snapshots</snapshot_storage_path>
        <coordination_settings>
            <operation_timeout_ms>10000</operation_timeout_ms>
            <session_timeout_ms>30000</session_timeout_ms>
        </coordination_settings>
        <raft_configuration>
            <server>
                <id>1</id>
                <hostname>localhost</hostname>
                <port>9234</port>
            </server>
        </raft_configuration>
    </keeper_server>

    <zookeeper>
        <node>
            <host>localhost</host>
            <port>9181</port>
        </node>
    </zookeeper>

    <distributed_ddl>
        <path>/clickhouse/task_queue/ddl</path>
    </distributed_ddl>
</clickhouse>
