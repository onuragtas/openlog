<Project Sdk="Microsoft.NET.Sdk">

  <!-- ASP.NET 4.x (System.Web) on .NET Framework 4.8 with the netstandard2.0 OpenLog.Agent build and OpenTelemetry's
       TelemetryHttpModule (README: .NET Framework). The reference assemblies come from
       Microsoft.NETFramework.ReferenceAssemblies, so it compiles on Linux (CI job dotnet-agent). CI job dotnet-agent-netfx
       runs it on Windows under IIS Express / IIS: test/netfx/run-iis.ps1 builds it with
       CopyLocalLockFileAssemblies + generated binding redirects and lays out the site. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/OpenLog.Agent/OpenLog.Agent.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="All" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNet" />
    <Reference Include="System.Web" />
    <Reference Include="System.Configuration" />
  </ItemGroup>

</Project>
