<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net8.0: ASP.NET Core + hosting; netstandard2.0: .NET Framework 4.6.2+ and older runtimes (no ASP.NET Core instrumentation) -->
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>OpenLog.Agent</RootNamespace>
    <AssemblyName>OpenLog.Agent</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>OpenLog.Agent</PackageId>
    <Description>openlog APM agent for .NET: an OpenTelemetry .NET distribution that sends traces, metrics and logs to openlog over OTLP (host linking, consistent sampling, SQL sanitization, runtime metrics).</Description>
    <PackageTags>openlog;opentelemetry;apm;observability;tracing;metrics;logging</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="OpenLog.Agent.Tests" />
    <InternalsVisibleTo Include="OpenLog.Agent.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
    <PackageReference Include="OpenTelemetry.Instrumentation.SqlClient" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Runtime" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
