{
  "name": "@openlog/node",
  "version": "0.1.9",
  "description": "openlog APM agent for Node.js: an OpenTelemetry distribution (traces, metrics, logs over OTLP)",
  "license": "Apache-2.0",
  "author": "openlog",
  "homepage": "https://github.com/onuragtas/openlog/tree/master/agents/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onuragtas/openlog.git",
    "directory": "agents/node"
  },
  "bugs": "https://github.com/onuragtas/openlog/issues",
  "keywords": [
    "openlog",
    "apm",
    "opentelemetry",
    "otel",
    "tracing",
    "observability"
  ],
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "type": "commonjs",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./nest": {
      "import": {
        "types": "./dist/esm/nest.d.ts",
        "default": "./dist/esm/nest.js"
      },
      "require": {
        "types": "./dist/cjs/nest.d.ts",
        "default": "./dist/cjs/nest.js"
      }
    },
    "./register": {
      "import": "./dist/esm/register.js",
      "require": "./dist/cjs/register.js",
      "default": "./dist/cjs/register.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/cjs/register.js",
    "./dist/esm/register.js"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "npm run build && tsc -p tsconfig.test.json && node scripts/run-tests.mjs unit",
    "test:apps:install": "npm ci --prefix test/apps/nest12 --no-audit --no-fund",
    "test:integration": "npm run build && tsc -p tsconfig.test.json && node scripts/run-tests.mjs integration",
    "bench": "npm run build && tsc -p tsconfig.test.json && node .test-build/test/bench/overhead.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@fastify/otel": "0.21.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@opentelemetry/exporter-logs-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.222.0",
    "@opentelemetry/instrumentation": "0.222.0",
    "@opentelemetry/instrumentation-aws-sdk": "0.77.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-graphql": "0.70.0",
    "@opentelemetry/instrumentation-grpc": "0.222.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-ioredis": "0.70.0",
    "@opentelemetry/instrumentation-koa": "0.70.0",
    "@opentelemetry/instrumentation-mongodb": "0.75.0",
    "@opentelemetry/instrumentation-mysql2": "0.68.0",
    "@opentelemetry/instrumentation-nestjs-core": "0.68.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/instrumentation-pino": "0.68.0",
    "@opentelemetry/instrumentation-redis": "0.70.0",
    "@opentelemetry/instrumentation-undici": "0.32.0",
    "@opentelemetry/instrumentation-winston": "0.66.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-logs": "0.222.0",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@opentelemetry/semantic-conventions": "1.43.0",
    "@opentelemetry/winston-transport": "0.32.0"
  },
  "peerDependencies": {
    "@opentelemetry/exporter-logs-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-metrics-otlp-grpc": "0.222.0",
    "@opentelemetry/exporter-trace-otlp-grpc": "0.222.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/exporter-logs-otlp-grpc": {
      "optional": true
    },
    "@opentelemetry/exporter-metrics-otlp-grpc": {
      "optional": true
    },
    "@opentelemetry/exporter-trace-otlp-grpc": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@koa/router": "15.7.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@types/node": "20.19.43",
    "eslint": "9.39.5",
    "express": "5.2.1",
    "fastify": "5.12.4",
    "graphql": "17.0.2",
    "ioredis": "6.0.0",
    "koa": "3.2.1",
    "mysql2": "3.24.4",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "redis": "6.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "winston": "3.19.0"
  }
}
