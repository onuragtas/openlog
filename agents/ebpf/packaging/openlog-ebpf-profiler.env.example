# openlog eBPF profiler configuration (docs/contracts/ebpf-profiler.md).
# Environment only: this is one daemon with a handful of settings, and the names are the ones every
# other openlog agent uses.

# Required. Without it the profiler refuses to start rather than sampling a machine and throwing every
# profile away.
OPENLOG_LICENSE_KEY=olk_replace_me

# Where to send. http:// is plaintext; https:// or no scheme is TLS.
OPENLOG_ENDPOINT=http://localhost:4318

# How long each profile covers. 60s matches the Go and Node.js producers.
#OPENLOG_PROFILE_INTERVAL=60s

# Samples per second per CPU, 1..1000. 99 rather than 100 so sampling does not fall into lockstep with
# timer-driven work. This is the one setting that can turn a profiler into the load it is measuring.
#OPENLOG_SAMPLE_FREQUENCY=99

#OPENLOG_COMPRESSION=gzip
#OPENLOG_EXPORT_TIMEOUT=10s
#OPENLOG_LOG_LEVEL=info

# Where the infra agent publishes host-id and its discovered service map. Read if present: it is what
# lets a sample be filed under "redis" instead of "redis-server". Absent is fine.
#OPENLOG_INFRA_RUNTIME_DIR=/run/openlog-infra-agent

# Set when the profiler runs in a container with the host root mounted read-only.
#OPENLOG_HOST_ROOT=/host
