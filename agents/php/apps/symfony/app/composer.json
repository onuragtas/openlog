{
    "name": "openlog/spike-symfony",
    "description": "Minimal Symfony 7.4 HttpKernel app for the PHP agent spike",
    "license": "Apache-2.0",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-redis": "*",
        "psr/container": "^2.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/http-foundation": "^7.4",
        "symfony/http-kernel": "^7.4",
        "symfony/routing": "^7.4"
    },
    "autoload": {
        "psr-4": {"App\\": "src/"}
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
