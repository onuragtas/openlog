APP_NAME=laravel-spike
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mariadb
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE=spike
DB_USERNAME=spike
DB_PASSWORD=spike

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
# One connection per FPM worker (as in production); per-request connects exhaust ephemeral ports under load.
REDIS_PERSISTENT=true
