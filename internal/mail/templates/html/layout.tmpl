{{define "html"}}<!doctype html><html lang="{{lang}}"><body style="font-family:system-ui,sans-serif;font-size:14px;line-height:1.5">{{template "content" .}}{{if .Link}}<p><a href="{{.Link}}" style="display:inline-block;padding:8px 16px;border-radius:6px;background:#2563eb;color:#fff;text-decoration:none">{{template "linkLabel" .}}</a></p><p style="color:#666;font-size:12px">{{.Link}}</p>{{end}}</body></html>{{end}}
